# ============================================
# AUXIDIEN WATCHER - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================

# RPC URL (BSC testnet by default; switch to mainnet for production)
RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Deployed Auxidien Oracle address
ORACLE_ADDRESS=

# Wallet that holds ORACLE_ROLE on the oracle contract
# Used to sign setPricePerOzE6 / setPriceWithMetals transactions
# WARNING: Keep this secret! Never share or commit!
PRIVATE_KEY=

# ============================================
# PRICE DATA SOURCE
# ============================================

# GoldAPI key (https://www.goldapi.io)
GOLDAPI_KEY=

# ============================================
# WATCHER CONFIGURATION
# ============================================

# Tick interval in milliseconds (default: 3600000 = 1 hour)
WATCHER_INTERVAL=3600000

# Delay between GoldAPI requests in ms (rate-limit safety, default: 300)
GOLDAPI_REQUEST_DELAY_MS=300

# GoldAPI response cache TTL in ms (default: 60000 = 1 minute)
GOLDAPI_CACHE_TTL_MS=60000

# Max oracle price step per update in basis points (default: 300 = 3%)
# Prevents single-tick jumps; clamps target price toward current when delta exceeds.
ORACLE_MAX_STEP_BPS=300
